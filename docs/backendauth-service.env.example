# Variables de entorno de ejemplo para el servicio de autenticación

# Puerto en el que escucha el servicio
PORT=4001

# Secreto para firmar tokens JWT
# ⚠️ IMPORTANTE: Cambiar este valor en producción
# Generar uno nuevo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-secret-key-change-in-production

# Duración de los tokens JWT (en segundos o formato de 'jsonwebtoken')
# Ejemplos: 3600 (1 hora), '7d' (7 días), '30d' (30 días)
JWT_EXPIRATION=30d

# Número de rondas de salt para bcrypt (más = más seguro pero más lento)
# Recomendado: 10-12 para producción
BCRYPT_SALT_ROUNDS=10

# Entorno de ejecución
NODE_ENV=development

# Base de datos (para cuando migres de memoria a BD real)
# DATABASE_URL=postgresql://user:password@localhost:5432/asocia
# DATABASE_URL=mongodb://localhost:27017/asocia

# CORS - Orígenes permitidos (separados por coma)
# En desarrollo: permite todo
# En producción: solo dominios específicos
CORS_ORIGIN=*
# CORS_ORIGIN=https://app.asocia.com,https://www.asocia.com

# Rate limiting (requests por minuto por IP)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Logging
LOG_LEVEL=debug
# LOG_LEVEL=info  # para producción

# Email (para recuperación de contraseña - futuro)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=noreply@asocia.com
# SMTP_PASSWORD=your-email-password
# SMTP_FROM=Asocia <noreply@asocia.com>

# Opcional: Sentry para error tracking
# SENTRY_DSN=https://...@sentry.io/...

# Opcional: Redis para caché de sesiones
# REDIS_URL=redis://localhost:6379
