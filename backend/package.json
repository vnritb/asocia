{
  "name": "asocia-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:gateway": "npm run dev -w api-gateway",
    "dev:membership": "npm run dev -w membership-service",
    "dev:chat": "npm run dev -w chat-service",
    "dev:translation": "npm run dev -w translation-service",
    "typecheck": "npm run typecheck -ws --if-present",
    "build": "npm run build -ws --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run .unit.test.ts",
    "pretest:integration:mock": "npm run build -w packages/shared",
    "test:integration:mock": "vitest run --config vitest.integration.mock.config.ts",
    "test:integration:real": "vitest run --config vitest.integration.real.config.ts",
    "test:integration": "npm run test:integration:mock",
    "test:coverage": "vitest run --coverage",
    "test:all": "npm run typecheck && npm run test"
  },
  "workspaces": [
    "packages/shared",
    "services/api-gateway",
    "services/chat-service",
    "services/membership-service",
    "services/translation-service"
  ],
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^1.0.4",
    "supertest": "^6.3.3",
    "typescript": "^5.3.3",
    "vitest": "^1.0.4"
  }
}