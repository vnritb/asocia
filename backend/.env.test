# Variables de entorno para tests del backend

# Base de datos de test (separada de desarrollo/producción)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB_TEST=asocia_test
POSTGRES_USER=asocia
POSTGRES_PASSWORD=asocia_secret

# URLs de servicios para tests de integración
API_GATEWAY_URL=http://localhost:4000
MEMBERSHIP_SERVICE_URL=http://localhost:4001
CHAT_SERVICE_URL=http://localhost:4002
TRANSLATION_SERVICE_URL=http://localhost:4003

# API Key de Anthropic para tests de traducción real (opcional)
# Si no se proporciona, los tests deberían usar mocks
ANTHROPIC_API_KEY=

# Configuración de tests
TEST_TIMEOUT=10000
INTEGRATION_TEST_ENABLED=true

# Logging
LOG_LEVEL=error
